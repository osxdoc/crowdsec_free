# Copy to .env and adjust. Values are only used by the one-shot bootstrap
# container on first start; existing configuration is never overwritten.

# Web UI login for user "admin". Leave empty to generate a random password
# (printed in `docker compose logs bootstrap`).
WEBUI_ADMIN_PASSWORD=change-this-password

# Token protecting the blocklist server's admin API. Leave empty to generate.
BLOCKLIST_ADMIN_TOKEN=change-this-token

# Hub collections installed at first start. Set to "" to skip the download.
HUB_COLLECTIONS=crowdsecurity/linux

# Host ports.
WEBUI_PORT=8081
LAPI_PORT=8080
BLOCKLIST_PORT=8082

# Compose subnet; must match api.server.trusted_ips in config/config.yaml.
CROWDSEC_SUBNET=172.28.0.0/16

# Version baked into the binaries; it also selects the hub branch. A version
# that is not a released-or-newer number ("local") makes `cscli hub update`
# request a CDN path that does not exist, so keep it >= the newest release.
CROWDSEC_VERSION=v1.8.2
