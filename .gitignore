# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*~
.pc

# IDEs
.vscode
.idea

# If vendor is included, allow prebuilt (wasm?) libraries.
!vendor/**/*.so

# Test binaries, built with `go test -c`
*.test
*.cover

# Test dependencies
test/tools/*

# Saved test status
test/bats/.bats/run-logs

# VMs used for dev/test

.vagrant

# Test binaries, built from *_test.go
pkg/csplugin/tests/cs_plugin_test*

# Output of test coverage
coverage.out
test/coverage/*

# Environment files
.env

# Development artifacts, backups, etc
*.swp
*.swo

# Dependencies are not vendored by default, but a tarball is created by "make vendor"
# and provided in the release. Used by gentoo, etc.
vendor/
vendor.tgz

# crowdsec binaries
cmd/crowdsec-cli/cscli
cmd/crowdsec/crowdsec
cmd/notification-*/notification-*

# self-hosted tools
/cswebui
/csblocklistd

# local build caches and scratch environments
/.build/

# Test cache (downloaded files)
.cache

# Release stuff
crowdsec-v*
msi
*.msi
**/*.nupkg
*.tgz

# Python
__pycache__
*.py[cod]
*.egg-info

# local agent/tooling dirs (not part of the repo)
.agents/
.claude/
.worktrees/

# docker deployment: a run inside deploy/docker fills ./config (hub content,
# credentials, engine defaults) and creates ./data (SQLite DBs, GeoIP). Only
# the templates listed below are tracked; new ones need an explicit "!" line.
/deploy/docker/.env
/deploy/docker/data/
/deploy/docker/config/*
!/deploy/docker/config/acquis.yaml
!/deploy/docker/config/blocklist.yaml
!/deploy/docker/config/config.yaml
!/deploy/docker/config/console.yaml
!/deploy/docker/config/webui.yaml

# macOS Finder metadata
.DS_Store
