[Unit]
Description=CrowdSec self-hosted web UI
Documentation=file:///usr/local/share/doc/crowdsec/self-hosted.md
After=crowdsec.service
Wants=crowdsec.service

[Service]
Type=simple
User=crowdsec
Group=crowdsec
Environment=LC_ALL=C LANG=C
ExecStart=/usr/local/bin/cswebui -config /etc/crowdsec/webui.yaml
Restart=always
RestartSec=10

# "Reload engine" in the UI runs engine.reload_command from webui.yaml.
# systemctl needs privileges; when cswebui runs as the crowdsec user, prefer
# reload_command: ["/usr/bin/pkill", "-HUP", "-x", "crowdsec"] instead.

[Install]
WantedBy=multi-user.target
